<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mmo_create_wizard_form" model="ir.ui.view">
        <field name="name">mmo.create.wizard.form</field>
        <field name="model">mmo.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create MMO">
                <group>
                    <field name="type"/>
                    <field name="title"/>
                    <field name="outsourcing_company_id"/>
                    <field name="original_drawing" filename="original_drawing_name"/>
                    <field name="original_drawing_name" invisible="1"/>
                    <field name="remark"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Create &amp; Confirm"
                            type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form></field>
    </record>

    <record id="action_mmo_create_wizard" model="ir.actions.act_window">
        <field name="name">Create MMO</field>
        <field name="res_model">mmo.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- Opens as a popup -->
        <field name="view_id" ref="view_mmo_create_wizard_form"/>
    </record>
</odoo>