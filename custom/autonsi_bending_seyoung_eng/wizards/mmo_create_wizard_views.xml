<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mmo_create_wizard_form" model="ir.ui.view">
        <field name="name">mmo.create.wizard.form</field>
        <field name="model">mmo.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create MMO">
                <group>
                    <field name="type"/>
                    <field name="title"/>
                    <field name="outsourcing_company_id"/>
                    <field name="original_drawing" filename="original_drawing_name"/>
                    <field name="original_drawing_name" invisible="1"/>
                    <field name="remark"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Create &amp; Confirm"
                            type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="piece_list_bending_form" model="ir.ui.view">
        <field name="name">Bending Data</field>
        <field name="model">bending.drawing.file.line.wizard</field>
        <field name="arch" type="xml">
            <form class="bending_form" create="false" delete="false">
                <style>
                    .bending_form {
                    <!--					padding-top: 0 !important;-->
                    <!--					padding-right: 0 !important;-->
                    <!--					padding-bottom: 0 !important;-->
                    padding: 0 !important;
                    }
                    .bending_group {
                    margin: 0 !important;
                    }
                    .o_control_panel {
                    padding: 0;
                    }
                    .o_cp_bottom {
                    display: none !important;
                    }
                    .o_form_statusbar {
                    margin: 0 !important;
                    }
                </style>
                <header>
                    <field name="bending_status" widget="statusbar" statusbar_visible="draft,done"/>

                    <button string="Bending Setting Data" class="btn-warning" name="open_bending_setting"
                            type="object"/>
                    <button string="Redraw" class="btn-primary" name="redraw_bending_data" type="object"/>
                    <button string="Complete" class="btn-primary" name="confirm_bending_data" type="object"/>
                    <button string="Refresh" class="btn-primary" name="refresh" type="object" invisible="0"/>
                    <button string="Next Page" class="btn-primary" name="next_page" type="object" invisible="0"/>
                    <button string="Close" class="btn-secondary close-bending" name="close_bending_form" type="object"/>
                    <button string="Edit" class="btn-secondary close-bending" name="edit_page" type="object"/>
                </header>
                <group class="bending_group">
                    <div class="o_bending_data"/>
                </group>
            </form>
        </field>
    </record>


    <record id="action_mmo_create_wizard" model="ir.actions.act_window">
        <field name="name">Create MMO</field>
        <field name="res_model">mmo.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> <!-- Opens as a popup -->
        <field name="view_id" ref="view_mmo_create_wizard_form"/>
    </record>
</odoo>